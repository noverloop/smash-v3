# Regenerable sim figures (source scripts stay tracked).
tools/radar-sim/output/

# EE deliverable drops (Finalized/): TRACKED — the RADAR_module drops are the
# only record of that work (NOT imported into the netlist; only
# companion_compute was). Ignored inside them: KiCad .history dirs (the
# "kicad git history"), top-level revision archives (duplicate the extracted
# dirs), and the bundled TI TIDM-953 reference design (public,
# re-downloadable, ~52 MB per copy ×4 revisions).
Finalized/**/.history/
# Same for WIP/ project drops (the power_board copy landed with its .history
# nested repo as a gitlink whose commits aren't in this repo — untracked).
WIP/**/.history/
WIP/**/~*.lck
~*.lck
Finalized/*.7z
Finalized/*.zip
Finalized/**/tidm953/
Finalized/**/tidm953.zip
Finalized/**/~*.lck

# KiCad working scratch inside the EE drops. The routed board + gerbers + fab
# zips are the deliverable; these are intermediate save-states and machine-
# regenerated local state:
#   *.bak_*        timestamped pre-edit snapshots of .kicad_pcb/.kicad_pro
#   BACKUP_*/      whole-project copies of an intermediate routing state
#   freerouting.*  Freerouting import/export scratch (.dsn in, .ses out)
#   *.kicad_prl    per-user UI state (the only file that differed between two
#                  otherwise byte-identical copies of the same board)
#   fp-info-cache  KiCad's footprint-library cache, rebuilt on open
# Matches the output/kicad_pcbs* treatment above. Not retroactive: the drops
# already committed in cbf9ccca keep the scratch that landed with them.
Finalized/**/*.bak_*
Finalized/**/BACKUP_*/
Finalized/**/freerouting.dsn
Finalized/**/freerouting.ses
Finalized/**/temp-freerouting.dsn
Finalized/**/*.kicad_prl
Finalized/**/fp-info-cache

# KiCad editor lock files, repo-wide. KiCad writes ~<name>.lck next to a board
# or project while it is open and removes it on close; a committed one is a
# stale lock from someone else's machine. They carry no design intent and
# conflict on every merge that touches a board dir (they get renamed on one
# side and deleted on the other). Supersedes the narrower windows_share/ and
# Finalized/ rules above. Retroactive: the ones already committed are untracked
# in the same commit that adds this rule.
~*.lck
