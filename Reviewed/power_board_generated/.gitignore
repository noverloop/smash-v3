# --- Full-pipeline build artifacts (all regenerable via the generator / sims) ---
# Per-config PCB/STEP/STL folders + the maximalist 3D exports + trace/via coupons.
# (The selective output/kicad_pcbs_smash rules above predate the per-config tree,
# so ignore the whole tree here.)
output/kicad_pcbs_smash/
output/render/
output/trace_coupon/
output/trace_strain/
output/trace_strain_envelope.txt
output/via_coupon/
output/worst_etch/
# Octopart/Nexar price-fetch snapshot (canonical prices live in assumptions.json)
tools/octopart_prices.json
# Allegro working-dir journals + numbered auto-backups (.pad libraries stay tracked)
archive/windows_share/*.jrl
archive/windows_share/*,[0-9]
# --- More regenerable artifacts (source scripts stay tracked) ---
# 3D bodies from tools/gen_3d.py; battery FEA solver files (CalculiX, like
# output/fea_smash); per-config PCBs from the user-facing export. All rebuildable.
output/3d/
output/battery_fea/
output/kicad_pcbs_user/
# (output/fab_notes/ from tools/gen_fab_notes.py is human-readable and IS tracked.)
# Redundant archive of the already-tracked tools/radar-sim/ tree (+ macOS cruft).
tools/radar-sim.zip
# Regenerable sim figures (source scripts stay tracked).
tools/radar-sim/output/

# EE deliverable drops (Finalized/): TRACKED — the RADAR_module drops are the
# only record of that work (NOT imported into the netlist; only
# companion_compute was). Ignored inside them: KiCad .history dirs (the
# "kicad git history"), top-level revision archives (duplicate the extracted
# dirs), and the bundled TI TIDM-953 reference design (public,
# re-downloadable, ~52 MB per copy ×4 revisions).
Finalized/**/.history/
# Same for WIP/ project drops (the power_board copy landed with its .history
# nested repo as a gitlink whose commits aren't in this repo — untracked).
WIP/**/.history/
WIP/**/~*.lck
~*.lck
Finalized/*.7z
Finalized/*.zip
Finalized/**/tidm953/
Finalized/**/tidm953.zip
Finalized/**/~*.lck
