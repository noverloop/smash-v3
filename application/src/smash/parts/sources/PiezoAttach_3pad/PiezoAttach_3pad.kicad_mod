(module "PiezoAttach_3pad" (layer F.Cu)
  (descr "Solder-pad trio for an aft piezoelectric shock/launch disk (CEB-21018-L100, Ø21 brass diaphragm, 3 wire leads Red/Blue/Black). Three 3.0x1.6mm SMD pads in a column at y=+2.6/0/-2.6mm where the disk's three leads land. Pads: 1=PIEZO+ (main electrode), 2=PIEZO_FB (feedback electrode), 3=PIEZO- (brass common). The disk seats in a milled pocket (piezo_disk_pocket) centred on this footprint.")
  (tags "piezo shock launch-detect setback 3-lead smash")
  (attr smd)
  (fp_text reference REF** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "PiezoAttach_3pad" (at 0 4.900) (layer F.SilkS) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_line (start -1.900 -4.100) (end 1.900 -4.100) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.900 -4.100) (end 1.900 4.100) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.900 4.100) (end -1.900 4.100) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.900 4.100) (end -1.900 -4.100) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.500 -3.700) (end 1.500 -3.700) (layer F.Fab) (width 0.1))
  (fp_line (start 1.500 -3.700) (end 1.500 3.700) (layer F.Fab) (width 0.1))
  (fp_line (start 1.500 3.700) (end -1.500 3.700) (layer F.Fab) (width 0.1))
  (fp_line (start -1.500 3.700) (end -1.500 -3.700) (layer F.Fab) (width 0.1))
  (fp_line (start -1.700 -3.900) (end 1.700 -3.900) (layer F.SilkS) (width 0.12))
  (fp_line (start 1.700 -3.900) (end 1.700 3.900) (layer F.SilkS) (width 0.12))
  (fp_line (start 1.700 3.900) (end -1.700 3.900) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.700 3.900) (end -1.700 -3.900) (layer F.SilkS) (width 0.12))
  (pad 1 smd rect (at 0.000 2.600) (size 3.000 1.600) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 0.000 0.000) (size 3.000 1.600) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at 0.000 -2.600) (size 3.000 1.600) (layers F.Cu F.Paste F.Mask))
)
