(module "PiezoDisc_PIC181_D10T05_Wrap" (layer F.Cu)
  (descr "PI Ceramic PIC181 piezo disc Ø10 x 0.5 mm, wrap-around contact (fired silver): both terminals on the bottom face. Pad 1 = MAIN (bottom electrode, Ø5 round, centre-offset west), pad 2 = WRAP (top electrode brought around, 1.6x2.5 strip at the east rim). In52/Sn48 118C low-temp step ONLY (depoling above ~Curie/2). Confirm the wrap-strip position against the PI Ceramic electrode drawing before fab.")
  (tags "piezo pzt disc shock launch-detect pi-ceramic pic181")
  (attr smd)
  (fp_text reference REF** (at 0 -6.2 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "PiezoDisc_PIC181_D10T05_Wrap" (at 0 6.2 0) (layer F.SilkS) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 5.25 0) (layer F.CrtYd) (width 0.05))
  (fp_circle (center 0 0) (end 5.0 0) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 5.2 0) (layer F.SilkS) (width 0.12))
  (pad 1 smd circle (at -1.000 0.000) (size 5.0 5.0) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 3.500 0.000) (size 1.6 2.5) (layers F.Cu F.Paste F.Mask))
)
