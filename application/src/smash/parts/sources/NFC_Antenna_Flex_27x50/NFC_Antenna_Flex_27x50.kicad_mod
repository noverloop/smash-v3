(module "NFC_Antenna_Flex_27x50" (layer F.Cu)
  (descr "Rectangular-spiral NFC 13.56 MHz antenna on flex. 27x50 mm, 4 turns, 0.3 mm trace + 0.3 mm gap. Spiral on F.Cu, inner-to-AC1 bridge on B.Cu. ~2.5 uH inductance, tunes to 13.56 MHz against ST25DV + trim cap.")
  (tags "nfc antenna flex spiral smash")
  (attr smd)
  (fp_text reference REF** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "NFC_Antenna_Flex_27x50" (at 0 26.50) (layer F.SilkS) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_line (start -14.000 -25.500) (end 14.000 -25.500) (layer F.CrtYd) (width 0.050))
  (fp_line (start 14.000 -25.500) (end 14.000 25.500) (layer F.CrtYd) (width 0.050))
  (fp_line (start 14.000 25.500) (end -14.000 25.500) (layer F.CrtYd) (width 0.050))
  (fp_line (start -14.000 25.500) (end -14.000 -25.500) (layer F.CrtYd) (width 0.050))
  (fp_line (start -13.500 -25.000) (end 13.500 -25.000) (layer F.Fab) (width 0.100))
  (fp_line (start 13.500 -25.000) (end 13.500 25.000) (layer F.Fab) (width 0.100))
  (fp_line (start 13.500 25.000) (end -13.500 25.000) (layer F.Fab) (width 0.100))
  (fp_line (start -13.500 25.000) (end -13.500 -25.000) (layer F.Fab) (width 0.100))
  (fp_line (start 12.850 24.350) (end -12.850 24.350) (layer F.Cu) (width 0.300))
  (fp_line (start -12.850 24.350) (end -12.850 -24.350) (layer F.Cu) (width 0.300))
  (fp_line (start -12.850 -24.350) (end 12.850 -24.350) (layer F.Cu) (width 0.300))
  (fp_line (start 12.850 -24.350) (end 12.250 -23.750) (layer F.Cu) (width 0.300))
  (fp_line (start 12.250 -23.750) (end 12.250 23.750) (layer F.Cu) (width 0.300))
  (fp_line (start 12.250 23.750) (end -12.250 23.750) (layer F.Cu) (width 0.300))
  (fp_line (start -12.250 23.750) (end -12.250 -23.750) (layer F.Cu) (width 0.300))
  (fp_line (start -12.250 -23.750) (end 12.250 -23.750) (layer F.Cu) (width 0.300))
  (fp_line (start 12.250 -23.750) (end 11.650 -23.150) (layer F.Cu) (width 0.300))
  (fp_line (start 11.650 -23.150) (end 11.650 23.150) (layer F.Cu) (width 0.300))
  (fp_line (start 11.650 23.150) (end -11.650 23.150) (layer F.Cu) (width 0.300))
  (fp_line (start -11.650 23.150) (end -11.650 -23.150) (layer F.Cu) (width 0.300))
  (fp_line (start -11.650 -23.150) (end 11.650 -23.150) (layer F.Cu) (width 0.300))
  (fp_line (start 11.650 -23.150) (end 11.050 -22.550) (layer F.Cu) (width 0.300))
  (fp_line (start 11.050 -22.550) (end 11.050 22.550) (layer F.Cu) (width 0.300))
  (fp_line (start 11.050 22.550) (end -11.050 22.550) (layer F.Cu) (width 0.300))
  (fp_line (start -11.050 22.550) (end -11.050 -22.550) (layer F.Cu) (width 0.300))
  (fp_line (start -11.050 -22.550) (end 11.050 -22.550) (layer F.Cu) (width 0.300))
  (fp_line (start 11.050 -22.550) (end 11.050 -22.550) (layer F.Cu) (width 0.300))
  (fp_line (start 11.050 -22.550) (end 11.050 22.250) (layer F.Cu) (width 0.300))
  (pad 1 smd rect (at 12.850 24.350) (size 0.750 0.750) (layers F.Cu F.Mask))
  (pad 2 smd rect (at 12.250 24.350) (size 0.750 0.750) (layers F.Cu F.Mask))
  (fp_line (start 11.050 22.250) (end 12.250 24.350) (layer B.Cu) (width 0.3))
  (pad 2 thru_hole circle (at 11.050 22.250) (size 0.6 0.6) (drill 0.3) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 12.250 24.350) (size 0.6 0.6) (drill 0.3) (layers *.Cu *.Mask))
)
