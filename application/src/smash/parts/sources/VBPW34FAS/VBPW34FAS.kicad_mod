(module "VBPW34FAS" (layer F.Cu)
  (descr "Vishay VBPW34FAS SMD PIN photodiode, gullwing (GW). Hand-authored from DS 81127 Rev 1.3 package drawing 6.541-5086.01-4 (recommended solder pad: 2 pads 1.75 x 1.8 mm, outer span 8.9 mm, inner gap 5.4 mm). Body 4.4 x 3.9 x 1.2 mm; lead span 6.4 mm.")
  (tags "photodiode IR PIN")
  (attr smd)
  (fp_text reference D** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_text value "VBPW34FAS" (at 0 0) (layer F.SilkS) hide
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_line (start -4.7 -2.2) (end 4.7 -2.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start 4.7 -2.2) (end 4.7 2.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start 4.7 2.2) (end -4.7 2.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start -4.7 2.2) (end -4.7 -2.2) (layer F.CrtYd) (width 0.05))
  (fp_line (start -2.2 -1.95) (end 2.2 -1.95) (layer F.Fab) (width 0.1))
  (fp_line (start 2.2 -1.95) (end 2.2 1.95) (layer F.Fab) (width 0.1))
  (fp_line (start 2.2 1.95) (end -2.2 1.95) (layer F.Fab) (width 0.1))
  (fp_line (start -2.2 1.95) (end -2.2 -1.95) (layer F.Fab) (width 0.1))
  (fp_line (start -2.2 -1.3) (end -1.55 -1.95) (layer F.Fab) (width 0.1))
  (fp_line (start -2.2 -2.05) (end 2.2 -2.05) (layer F.SilkS) (width 0.2))
  (fp_line (start -2.2 2.05) (end 2.2 2.05) (layer F.SilkS) (width 0.2))
  (fp_line (start -4.6 -0.9) (end -4.6 0.9) (layer F.SilkS) (width 0.2))
  (pad 1 smd rect (at -3.575 0 0) (size 1.75 1.8) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 3.575 0 0) (size 1.75 1.8) (layers F.Cu F.Paste F.Mask))
)
