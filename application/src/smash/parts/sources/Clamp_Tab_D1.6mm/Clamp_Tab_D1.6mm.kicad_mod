(module "Clamp_Tab_D1.6mm" (layer F.Cu)
  (descr "PLACEHOLDER parachute nichrome clamp tab (wires are clamped, not soldered): 1.6 mm SMD land until the clamp part is chosen.")
  (tags "pogo test smd minimal smash")
  (attr smd)
  (fp_text reference REF** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "Clamp_Tab_D1.6mm" (at 0 0) (layer F.Fab) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_line (start -0.800 -0.800) (end 0.800 -0.800) (layer F.CrtYd) (width 0.05))
  (fp_line (start 0.800 -0.800) (end 0.800 0.800) (layer F.CrtYd) (width 0.05))
  (fp_line (start 0.800 0.800) (end -0.800 0.800) (layer F.CrtYd) (width 0.05))
  (fp_line (start -0.800 0.800) (end -0.800 -0.800) (layer F.CrtYd) (width 0.05))
  (pad 1 smd circle (at 0 0) (size 1.6 1.6) (layers F.Cu F.Mask))
)
