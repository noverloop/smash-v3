(module "Pogo_Pad_S2.0mm" (layer F.Cu)
  (descr "Minimal SMD pogo contact pad: 2.0mm SQUARE copper, no silkscreen ring, no oversized courtyard. Pin-1 / group-start marker variant of Pogo_Pad_D2.0mm — same 2.0 mm bounding size and same pitch, so a bench fixture and its pogo bed are unchanged; the square silhouette is the only difference and it marks where a silkscreen-grouped run of pads STARTS.")
  (tags "pogo test smd minimal smash pin1")
  (attr smd)
  (fp_text reference REF** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "Pogo_Pad_S2.0mm" (at 0 0) (layer F.Fab) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_line (start -1.000 -1.000) (end 1.000 -1.000) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.000 -1.000) (end 1.000 1.000) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.000 1.000) (end -1.000 1.000) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.000 1.000) (end -1.000 -1.000) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at 0 0) (size 2.0 2.0) (layers F.Cu F.Mask))
)
