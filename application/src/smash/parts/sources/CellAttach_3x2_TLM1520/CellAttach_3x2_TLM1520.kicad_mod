(module "CellAttach_3x2_TLM1520" (layer F.Cu)
  (descr "Battery cell-attach pad array for 3x Tadiran TLM-1520HPM/S. 3 columns x 2 rows of 3.0x2.0mm pads. Columns at +/-4.5mm X (1.5mm gap between cells); rows at +/-2.5mm Y (3mm gap between + and - tabs). Pads: 1=BT1+, 2=BT1-, 3=BT2+, 4=BT2-, 5=BT3+, 6=BT3-.")
  (tags "battery cell-attach tlm-1520 smash")
  (attr smd)
  (fp_text reference REF** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "CellAttach_3x2_TLM1520" (at 0 4.700) (layer F.SilkS) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_line (start -6.400 -3.900) (end 6.400 -3.900) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6.400 -3.900) (end 6.400 3.900) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6.400 3.900) (end -6.400 3.900) (layer F.CrtYd) (width 0.05))
  (fp_line (start -6.400 3.900) (end -6.400 -3.900) (layer F.CrtYd) (width 0.05))
  (fp_line (start -6.000 -3.500) (end 6.000 -3.500) (layer F.Fab) (width 0.1))
  (fp_line (start 6.000 -3.500) (end 6.000 3.500) (layer F.Fab) (width 0.1))
  (fp_line (start 6.000 3.500) (end -6.000 3.500) (layer F.Fab) (width 0.1))
  (fp_line (start -6.000 3.500) (end -6.000 -3.500) (layer F.Fab) (width 0.1))
  (fp_line (start -6.200 -3.700) (end 6.200 -3.700) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.200 -3.700) (end 6.200 3.700) (layer F.SilkS) (width 0.12))
  (fp_line (start 6.200 3.700) (end -6.200 3.700) (layer F.SilkS) (width 0.12))
  (fp_line (start -6.200 3.700) (end -6.200 -3.700) (layer F.SilkS) (width 0.12))
  (fp_line (start -2.250 -3.700) (end -2.250 3.700) (layer F.SilkS) (width 0.1))
  (fp_line (start 2.250 -3.700) (end 2.250 3.700) (layer F.SilkS) (width 0.1))
  (pad 1 smd rect (at -4.500 2.500) (size 3.000 2.000) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at -4.500 -2.500) (size 3.000 2.000) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at 0.000 2.500) (size 3.000 2.000) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at 0.000 -2.500) (size 3.000 2.000) (layers F.Cu F.Paste F.Mask))
  (pad 5 smd rect (at 4.500 2.500) (size 3.000 2.000) (layers F.Cu F.Paste F.Mask))
  (pad 6 smd rect (at 4.500 -2.500) (size 3.000 2.000) (layers F.Cu F.Paste F.Mask))
)
