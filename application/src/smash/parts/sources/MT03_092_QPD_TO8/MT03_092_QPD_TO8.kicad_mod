(module "MT03_092_QPD_TO8" (layer F.Cu)
  (descr "Marktech MT03-092 / QD50PV2-11-8 Quadrant Silicon Photodiode in TO-8 6-pin hermetic. Body Ø15.4mm, 8mm active area, 200um quadrant gaps. Pin 1=Q4, Pin 2=common cathode (backside weld), Pin 3=Q3, Pin 4=Q1, Pin 5=NC, Pin 6=Q2. Leads: two rows of 3, 2.54mm pitch, rows 10.16mm apart (DS p2: 2.54 REF 4 PL / 10.16 REF 3 PL), Ø0.45 leads.")
  (tags "qpd photodiode to-8 marktech")
  (attr through_hole)
  (fp_text reference REF** (at 0 -9 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "MT03_092_QPD_TO8" (at 0 9 0) (layer F.SilkS) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 8.2 0) (layer F.CrtYd) (width 0.05))
  (fp_circle (center 0 0) (end 7.7 0) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 7.9 0) (layer F.SilkS) (width 0.12))
  (fp_circle (center 0 0) (end 4.0 0) (layer F.Fab) (width 0.05))
  (fp_text user "Q1" (at -1.27 -1.27 0) (layer F.SilkS)
    (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "Q2" (at 1.27 -1.27 0) (layer F.SilkS)
    (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "Q3" (at 1.27 1.27 0) (layer F.SilkS)
    (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "Q4" (at -1.27 1.27 0) (layer F.SilkS)
    (effects (font (size 0.5 0.5) (thickness 0.08))))
  (pad 1 thru_hole circle (at -2.540 5.080) (size 1.5 1.5) (drill 0.7) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 0.000 5.080) (size 1.5 1.5) (drill 0.7) (layers *.Cu *.Mask))
  (pad 3 thru_hole circle (at 2.540 5.080) (size 1.5 1.5) (drill 0.7) (layers *.Cu *.Mask))
  (pad 4 thru_hole circle (at -2.540 -5.080) (size 1.5 1.5) (drill 0.7) (layers *.Cu *.Mask))
  (pad 5 thru_hole circle (at 0.000 -5.080) (size 1.5 1.5) (drill 0.7) (layers *.Cu *.Mask))
  (pad 6 thru_hole circle (at 2.540 -5.080) (size 1.5 1.5) (drill 0.7) (layers *.Cu *.Mask))
)
