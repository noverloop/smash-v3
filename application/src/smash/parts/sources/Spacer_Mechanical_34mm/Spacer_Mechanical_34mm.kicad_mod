(module "Spacer_Mechanical_34mm" (layer F.Cu)
  (descr "Mechanical interposer between two folded snake tiles. No copper, no signals — sits in the gap between PCB(N) top face and PCB(N+1) top face (the chip-to-chip clash zone in the accordion fold), with cavities milled for the chips on both adjacent faces. Takes launch-G axial load off the chips. Outer outline + cavity zone are drawn at panel-place time; this footprint is a placeholder so SKiDL can put a Part on the tile.")
  (tags "spacer mechanical interposer smash")
  (attr smd)
  (fp_text reference REF** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "Spacer_Mechanical_34mm" (at 0 5.0) (layer F.SilkS) hide
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 1.0 0) (layer F.SilkS) (width 0.12))
  (fp_circle (center 0 0) (end 0.5 0) (layer F.CrtYd) (width 0.05))
  (pad 1 smd circle (at 0 0) (size 0.8 0.8) (layers F.Cu F.Mask))
)
