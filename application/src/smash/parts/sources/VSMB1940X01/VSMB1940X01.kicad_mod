(module "VSMB1940X01" (layer F.Cu)
  (descr "Vishay VSMB1940X01 940 nm IR emitter, 0805 chipLED form. Hand-authored from DS 81933 Rev 1.6 package drawing 6.541-5064.01-4 (recommended solder pad: 2 pads 1.0 x 1.45 mm, inner gap 0.6 mm). Body 2.0 x 1.25 x 0.85 mm.")
  (tags "IR LED emitter 940nm")
  (attr smd)
  (fp_text reference D** (at 0 0) (layer F.SilkS)
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_text value "VSMB1940X01" (at 0 0) (layer F.SilkS) hide
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_line (start -1.55 -0.975) (end 1.55 -0.975) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.55 -0.975) (end 1.55 0.975) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.55 0.975) (end -1.55 0.975) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.55 0.975) (end -1.55 -0.975) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.0 -0.625) (end 1.0 -0.625) (layer F.Fab) (width 0.1))
  (fp_line (start 1.0 -0.625) (end 1.0 0.625) (layer F.Fab) (width 0.1))
  (fp_line (start 1.0 0.625) (end -1.0 0.625) (layer F.Fab) (width 0.1))
  (fp_line (start -1.0 0.625) (end -1.0 -0.625) (layer F.Fab) (width 0.1))
  (fp_line (start -1.0 -0.3) (end -0.675 -0.625) (layer F.Fab) (width 0.1))
  (fp_line (start -1.0 -0.875) (end 1.0 -0.875) (layer F.SilkS) (width 0.2))
  (fp_line (start -1.0 0.875) (end 1.0 0.875) (layer F.SilkS) (width 0.2))
  (fp_line (start -1.5 -0.7) (end -1.5 0.7) (layer F.SilkS) (width 0.2))
  (pad 1 smd rect (at -0.8 0 0) (size 1.0 1.45) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 0.8 0 0) (size 1.0 1.45) (layers F.Cu F.Paste F.Mask))
)
